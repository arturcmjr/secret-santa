    "version:check": "node scripts/check-version.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "@lottiefiles/dotlottie-web": "^0.81.0",
    "@lucide/angular": "^1.64.0",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.50",
    "date-fns": "^4.4.0",
    "express": "^5.1.0",
