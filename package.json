{
  "name": "secret-santa",
  "version": "1.3.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:firebase": "ng build && node scripts/prepare-functions.mjs",
    "serve:ssr": "node dist/prod/server/server.mjs",
